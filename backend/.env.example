# DentalAI Backend Configuration

# AI Provider settings: "auto", "gemini", "openai", "mock"
AI_PROVIDER=auto

# Google Gemini API key (optional - enables real Gemini vision analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API key (optional - enables real GPT-4o vision analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=45
